# Canonical site origin. Must include the scheme and no trailing slash.
# Leave unset rather than blank — a blank value used to fail the build, and is
# now ignored by the fallback in data/personal.ts.
NEXT_PUBLIC_SITE_URL=https://neema-sunder.vercel.app

# --- Portfolio assistant (/api/chat) -----------------------------------------
# Any OpenAI-compatible inference endpoint works: Groq, Together, OpenRouter,
# Fireworks, or a self-hosted vLLM/Ollama server. Only the three vars below
# change — no code changes needed to switch provider.
#
# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Without AI_API_KEY the widget reports that the assistant is not configured.

# Groq: free tier, create a key at https://console.groq.com/keys
AI_API_KEY=gsk_...

# Defaults shown. Override to switch provider or model.
#   Together    https://api.together.xyz/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Local vLLM  http://localhost:8000/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# IMPORTANT: the provider's public docs list models your key may not actually
# have. Check what YOUR key can use before setting this:
#   curl https://api.groq.com/openai/v1/models \
#     -H "Authorization: Bearer $AI_API_KEY" | grep -o '"id":"[^"]*"'
# A model the key cannot access returns 404, which the route reports as
# "The assistant is misconfigured."
AI_MODEL=openai/gpt-oss-120b
